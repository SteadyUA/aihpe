{
    "name": "code-app-monorepo",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "server": "npm run dev --prefix server",
        "client": "npm run dev --prefix client",
        "dev": "concurrently \"npm run server\" \"npm run client\"",
        "build": "cd client && npm run build && cd ../server && npm run build && mkdir -p dist/public && cp -r ../client/dist/* dist/public/",
        "start": "cd server && npm start"
    },
    "devDependencies": {
        "concurrently": "^7.6.0"
    },
    "workspaces": [
        "client",
        "server"
    ]
}